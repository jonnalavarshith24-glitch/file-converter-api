NODE_ENV=development
PORT=3000
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379

# Uploads / storage
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=25
FILE_TTL_MINUTES=60

# Worker
WORKER_CONCURRENCY=4

# API protection
RATE_LIMIT_PER_MIN=30

# Chromium (Markdown -> PDF). Leave empty to use Puppeteer's bundled browser.
CHROMIUM_PATH=
# Required when running Chromium as root / inside most containers
CHROMIUM_NO_SANDBOX=false
