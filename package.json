{
  "name": "file-converter-api",
  "version": "1.0.0",
  "description": "Asynchronous file conversion API with a Redis-backed job queue (images, Markdown, CSV/JSON).",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "test": "vitest run"
  },
  "keywords": ["file-conversion", "bullmq", "express", "sharp", "puppeteer", "nodejs"],
  "license": "MIT",
  "dependencies": {
    "bullmq": "^5.12.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "markdown-it": "^14.1.0",
    "multer": "^2.0.0",
    "pino": "^9.4.0",
    "puppeteer": "^23.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "pino-pretty": "^11.2.2",
    "vitest": "^2.1.0"
  }
}
